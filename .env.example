# Veda AI - Environment Configuration Example
# Copy this file to .env and insert your API keys

# Sarvam AI API Key (Primary LLM Engine: sarvam-105b)
# https://www.sarvam.ai/
SARVAM_API_KEY=""

# Groq API Key (Fallback 1: llama-3.3-70b-versatile & Whisper audio transcription)
# https://console.groq.com/keys
GROQ_API_KEY=""

# NVIDIA API Key (Fallback 2: meta/llama-3.3-70b-instruct / nemotron via NVIDIA NIM)
# https://build.nvidia.com/
NVIDIA_API_KEY=""

# Google Gemini API Key (Fallback 3: Gemini Flash)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Server Configuration
PORT=5000
FLASK_DEBUG=false
FLASK_SECRET_KEY=""
